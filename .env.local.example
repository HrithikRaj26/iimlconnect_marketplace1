# Lost & Found route handlers (server-only — never exposed to the client).
# Same project as src/lib/supabase.ts points to (yrnllcupnbwlzaxdcngz.supabase.co).
SUPABASE_URL=https://yrnllcupnbwlzaxdcngz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Matching engine / retention (optional — sensible defaults if unset)
MATCH_PRECISION_THRESHOLD=0.55
RETENTION_PURGE_DAYS=30

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# when calling /api/lost-found/retention/purge (see vercel.json). Set the
# same value in Vercel's project env vars.
CRON_SECRET=

# Brevo SMTP Configuration for dispatching emails
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_FROM_EMAIL=pgp41103@iiml.ac.in
